{UTF-8}
Llegadas de pacientes= A FUNCTION OF(Confianza comunitaria)
	~	Dmnl
	~	Variable del diagrama causal
	|

Cola de espera= A FUNCTION OF(Llegadas de pacientes, Abandonos, Inicio de atencion)
	~	Dmnl
	~	Variable del diagrama causal
	|

Tiempo de espera= A FUNCTION OF(Cola de espera, Profesionales disponibles)
	~	Dmnl
	~	Variable del diagrama causal
	|

Abandonos= A FUNCTION OF(Tiempo de espera)
	~	Dmnl
	~	Variable del diagrama causal
	|

Inicio de atencion= A FUNCTION OF(Cola de espera, Profesionales disponibles)
	~	Dmnl
	~	Variable del diagrama causal
	|

Pacientes atendidos= A FUNCTION OF(Inicio de atencion)
	~	Dmnl
	~	Variable del diagrama causal
	|

Confianza comunitaria= A FUNCTION OF(Pacientes atendidos, Tiempo de espera, Abandonos)
	~	Dmnl
	~	Variable del diagrama causal
	|

Profesionales disponibles= A FUNCTION OF(Profesionales disponibles)
	~	Dmnl
	~	Variable del diagrama causal
	|

FINAL TIME= 12
	~	Hora
	~	Parametro de control de la simulacion
	|

INITIAL TIME= 0
	~	Hora
	~	Parametro de control de la simulacion
	|

TIME STEP= 0.0625
	~	Hora
	~	Parametro de control de la simulacion
	|

SAVEPER= TIME STEP
	~	Hora
	~	Frecuencia de registro
	|

