{UTF-8}
Cola de espera= INTEG(Llegadas-Inicio de atencion-Abandonos, 0)
	~	pacientes
	~	Pacientes esperando turno
	|

En atencion= INTEG(Inicio de atencion-Fin de atencion, 0)
	~	pacientes
	~	Pacientes siendo atendidos
	|

Atendidos= INTEG(Fin de atencion, 0)
	~	pacientes
	~	Pacientes atendidos en la jornada
	|

Abandonos acumulados= INTEG(Abandonos, 0)
	~	pacientes
	~	Pacientes que se retiran sin atencion
	|

Confianza comunitaria= INTEG(Ganancia de confianza-Perdida de confianza, 0.75)
	~	Dmnl
	~	Confianza de la comunidad en el puesto de salud
	|

Llegadas= IF THEN ELSE(Time<Duracion de jornada, Tasa base de llegadas*Factor de demanda*Efecto de la confianza, 0)
	~	pacientes/Hora
	~	Llegada de pacientes durante la jornada
	|

Inicio de atencion= MIN(Cola de espera/TIME STEP, Profesionales libres/TIME STEP)
	~	pacientes/Hora
	~	Pacientes que pasan a consulta
	|

Fin de atencion= En atencion/Duracion de atencion
	~	pacientes/Hora
	~	Pacientes que terminan su consulta
	|

Abandonos= Cola de espera*Fraccion de abandono
	~	pacientes/Hora
	~	Pacientes que se retiran por la espera
	|

Ganancia de confianza= Fin de atencion*Efecto por atencion
	~	1/Hora
	~	La atencion oportuna aumenta la confianza
	|

Perdida de confianza= Abandonos*Efecto por abandono+MAX(Tiempo de espera estimado-Tolerancia de espera, 0)*Efecto por espera larga
	~	1/Hora
	~	Abandonos y esperas largas reducen la confianza
	|

Efecto de la confianza= 0.4+0.8*MAX(0, MIN(1, Confianza comunitaria))
	~	Dmnl
	~	Factor de demanda segun la confianza
	|

Profesionales libres= MAX(Profesionales-En atencion, 0)
	~	profesionales
	~	Profesionales sin paciente
	|

Capacidad de atencion= Profesionales/Duracion de atencion
	~	pacientes/Hora
	~	Pacientes que el puesto puede atender por hora
	|

Tiempo de espera estimado= Cola de espera/Capacidad de atencion
	~	Hora
	~	Espera esperada para quien llega
	|

Fraccion de abandono= MIN(0.5, Sensibilidad al abandono*Tiempo de espera estimado)
	~	1/Hora
	~	Proporcion de la cola que se retira por hora
	|

Tasa base de llegadas= 7.503
	~	pacientes/Hora
	~	Llegadas por hora con confianza media (calibrado con 4256 citas)
	|

Factor de demanda= 1
	~	Dmnl
	~	Multiplicador para probar escenarios de demanda
	|

Duracion de jornada= 9
	~	Hora
	~	Horas en que se reciben pacientes
	|

Profesionales= 4
	~	profesionales
	~	Profesionales de salud disponibles (calibrado con 4256 citas)
	|

Duracion de atencion= 0.3008
	~	Hora
	~	Duracion media de una consulta (calibrado con 4256 citas)
	|

Efecto por atencion= 0.002
	~	Dmnl
	~	Confianza ganada por paciente atendido
	|

Efecto por abandono= 0.01
	~	Dmnl
	~	Confianza perdida por abandono
	|

Tolerancia de espera= 0.5
	~	Hora
	~	Espera aceptada por la comunidad
	|

Efecto por espera larga= 0.05
	~	1/Hora
	~	Confianza perdida por esperas superiores a la tolerancia
	|

Sensibilidad al abandono= 0.1
	~	1/Hora/Hora
	~	Que tan rapido abandonan los pacientes al esperar
	|

FINAL TIME= 12
	~	Hora
	~	Parametro de control de la simulacion
	|

INITIAL TIME= 0
	~	Hora
	~	Parametro de control de la simulacion
	|

TIME STEP= 0.0625
	~	Hora
	~	Parametro de control de la simulacion
	|

SAVEPER= TIME STEP
	~	Hora
	~	Frecuencia de registro
	|

